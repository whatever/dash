# Copy to .env, then: docker compose up --build
# Everything is optional. The defaults run with a fake hermes and no Nango.

# --- hermes ---------------------------------------------------------------
# Default: the fake-hermes service in compose.yaml (echoes your message).
# Real hermes through its ingress:
# HERMES_BASE_URL=https://wap.geometry.dev/v1
# HERMES_API_KEY=<API_SERVER_KEY from geometry/hermes>
# HERMES_MODEL=hermes-opus

# --- Bedrock (memories) ---------------------------------------------------
# Without credentials, chat still works but no memories are recalled or saved.
# Option 1: a profile from ~/.aws (mounted read-only into api and worker).
# AWS_PROFILE=default
# Option 2: keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Nango (connected apps) -----------------------------------------------
# Never change this after you connect an app; stored tokens become unreadable.
# Make it with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=
NANGO_DASHBOARD_PASSWORD=change-me
# After the first `up`, sign in at http://localhost:3003 (user: admin), copy the
# environment's secret key here, then: docker compose up -d api worker
NANGO_SECRET_KEY=
