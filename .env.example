#
# Configure AWS keys for bedrock

AWS_ACCESS_KEY_ID="AK******************"
AWS_SECRET_ACCESS_KEY="****************************************"
AWS_REGION="*********"

#     ___   _____________   ________
#    /   | / ____/ ____/ | / /_  __/
#   / /| |/ / __/ __/ /  |/ / / /
#  / ___ / /_/ / /___/ /|  / / /
# /_/  |_\____/_____/_/ |_/ /_/
#
# Configure the agent's model. Compose defaults to the dash-opus alias in LiteLLM.
# Leave AGENT_BASE_URL empty to call Bedrock directly with a Pydantic AI model string.

AGENT_MODEL="dash-opus"
AGENT_BASE_URL="http://litellm:4000/v1"
AGENT_THINKING="low"

